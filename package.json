{
  "name": "upload-release-assets",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action for uploading assets to a Release",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --target=node24 --minify --outfile=dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AButler/upload-release-assets.git"
  },
  "keywords": [
    "actions",
    "node",
    "github",
    "release"
  ],
  "author": "AButler",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "fast-glob": "^3.3.3",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "@vitest/coverage-v8": "^4.1.5",
    "all-contributors-cli": "^6.26.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
